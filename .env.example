# OpenAI (이 키를 설정하면 채팅과 임베딩에 OpenAI를 사용해요)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (OPENAI_API_KEY가 비어 있을 때 사용해요)
# AZURE_OPENAI_API_KEY를 비워 두면 az login 계정으로 인증해요.
AZURE_OPENAI_ENDPOINT=https://<리소스이름>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_KEY=

# 클러스터·모니터링
KUBEOPS_KUBECONFIG=.kube/agent.kubeconfig
PROMETHEUS_URL=http://127.0.0.1:9090
KUBEOPS_NAMESPACE=demo

# 로컬 kind-datacenterusedaws 실습에서 제너레이터·제한 자동 조치를 사용할 때만 1로 지정한다.
KUBEOPS_LOCAL_LAB=0
# 1이면 로컬 실습에서도 증설 전에 비용 검토 티켓을 발급한다.
KUBEOPS_BILLABLE_CAPACITY=0
# 티켓 발급 시 macOS 알림을 요청한다. 0으로 바꿔도 앱 알림함은 유지된다.
KUBEOPS_DESKTOP_NOTIFICATIONS=1

# 조치 후 결과 검증에 쓰는 대기 시간(초)
KUBEOPS_VERIFY_SECONDS=60

# 선택 사항. Copilot 서버에서 demo/api Service를 통해 접근할 수 있는 대표 읽기 전용 GET 주소.
# 지정하면 api 단독 진단 때 3회씩 두 구간을 확인한다.
KUBEOPS_DEMO_API_PROBE_URL=
